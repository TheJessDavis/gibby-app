# Gibby Class Manager - environment variables
#
# Copy to .env and fill in real values. NEVER commit .env; it is gitignored.
# In production these are set in the Render dashboard, not in a file.
#
# Every value below is read via os.environ; nothing here has a secret default
# baked into the source.

# ---------------------------------------------------------------- core ----
# Port to listen on (Render sets this for you).
PORT=
# Where the SQLite database lives. Point at a mounted disk in production.
DATA_DIR=
# Password given to accounts created by the initial seed. If unset, a random one
# is generated and printed once at startup. Seeded accounts must change it at
# first sign-in either way.
SEED_PASSWORD=

# ------------------------------------------------------------- email ----
# Set EMAIL_LIVE=true to actually send. Anything else stays in dry-run.
EMAIL_LIVE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# Google Workspace app password. Not your normal account password.
SMTP_PASS=
MAIL_FROM=

# -------------------------------------------------------- external posting ----
# Master switch. GIBBY_LIVE=true lets the app really post to these platforms.
GIBBY_LIVE=

# Eventbrite personal OAuth token, plus the organization and organizer to post as.
EVENTBRITE_TOKEN=
EVENTBRITE_ORG_ID=
EVENTBRITE_ORGANIZER_ID=

# Facebook Page id and a long-lived Page access token.
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Wix API key and site id.
WIX_API_KEY=
WIX_SITE_ID=

# Canva API token and the brand template the class poster is built from.
CANVA_TOKEN=
CANVA_TEMPLATE_ID=

# ----------------------------------------------------- google calendar ----
# GCAL_LIVE=true to read and write the shared calendar for real.
GCAL_LIVE=
# The calendar's id (looks like an email address).
GCAL_CALENDAR_ID=
# The ENTIRE service-account JSON key, on one line. Needed only to WRITE classes
# back onto the calendar. Many Workspace organisations block service account keys
# (iam.disableServiceAccountKeyCreation); if yours does, use GCAL_ICS_URL below
# instead, which reads the calendar with no Google Cloud project at all.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar's private iCal address, from Calendar settings, Integrate calendar,
# "Secret address in iCal format". Read-only: open times become bookable slots.
# Treat it as a secret; anyone with it can read the calendar.
GCAL_ICS_URL=
# Which days to open, Mon=0 to Sun=6. "5" is Saturdays only. Blank means every day.
GCAL_DAYS=
GCAL_OPEN_HOUR=
GCAL_CLOSE_HOUR=
